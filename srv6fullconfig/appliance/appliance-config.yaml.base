apiVersion: v1beta1
kind: ApplianceConfig
ocpRelease:
  version: '4.22'
  url: quay.io/openshift-release-dev/ocp-release:4.22.3-x86_64
diskSizeGB: 200
userCorePass: core
stopLocalRegistry: false
additionalImages:
  - name: quay.io/redhat-user-workloads/telco-5g-tenant/openperouter-operator-5-0:latest
  - name: quay.io/mavazque/ign-converter:latest
  - name: registry.redhat.io/rhel9/support-tools:latest
  # Used by the CSR approver embedded in the companion config-image ISO.
  - name: registry.redhat.io/openshift4/ose-cli:v4.22.3
